{
  "name": "pick-scorer",
  "version": "1.0",
  "max_candidates": 25,
  "input": {
    "type": "object",
    "required": ["repo", "bucket", "candidates"],
    "properties": {
      "repo": {"type": "string"},
      "bucket": {"type": "string"},
      "candidates": {
        "type": "array",
        "maxItems": 25,
        "items": {
          "type": "object",
          "required": ["id", "title", "labels", "points", "state"],
          "properties": {
            "id": {"type": "string"},
            "title": {"type": "string"},
            "labels": {"type": "array", "items": {"type": "string"}},
            "points": {"type": ["number", "null"]},
            "state": {"type": "string"},
            "project": {"type": ["string", "null"]},
            "parent": {"type": ["string", "null"]}
          }
        }
      }
    }
  },
  "output": {
    "type": "object",
    "required": ["scores"],
    "properties": {
      "scores": {
        "type": "array",
        "maxItems": 25,
        "items": {
          "type": "object",
          "required": ["id", "score", "reason"],
          "properties": {
            "id": {"type": "string"},
            "score": {"type": "integer", "minimum": 1, "maximum": 10, "description": "estimated effort, 1 tiny to 10 large; lower ranks first"},
            "reason": {"type": "string", "maxLength": 120, "description": "one line, no newlines"}
          }
        }
      }
    },
    "rules": ["one entry per input candidate id, no extras", "reason has no newline"]
  }
}
