  "summary": {
    "what": "Tests whether the persona-accuracy adversary catches a seed decision that misstates what the to-seed transcript actually decided, without flagging faithful decisions or defects that belong to other personas.",
    "metrics": {
      "correct": "Right call on this case: caught the planted defect (by field or by quoting the changed text), or stayed silent where it should. Main score.",
      "recall": "On planted defects only: did it raise a refutation on the planted field?",
      "specificity": "On clean seeds and off-lens distractors: did it stay quiet (no refutation on that field, none at all for clean seeds)?",
      "quote_ok": "When it raised refutations, was every transcript_span a verbatim quote from the transcript?",
      "format_ok": "Did it reply with a bare JSON array matching the refutation contract (no prose, no code fence)?",
      "covered": "Did it avoid the coverage-limited error form (i.e. actually check the seed)?",
      "field_ok": "When it caught a planted defect, did it cite the right seed field path (e.g. decisions[8], not a line number)?"
    },
    "kinds": {
      "planted": "A real seed with one decision changed so it no longer matches the transcript (drift, stale, scope creep, or negation). Should flag that field.",
      "distractor": "A real seed with a made-up rationale added. That is the Grounding persona's job. Accuracy should not flag it.",
      "clean": "The real draft seed, unchanged. Production returned no refutations. Should return []."
    },
    "groups": {
      "Catch misstated decisions": [
        "planted"
      ],
      "Stay quiet when faithful": [
        "clean",
        "distractor"
      ]
    }
  },
  "harness_sha": "cb4e25ab2819a99c7eadbe2ac393d9d26c0162ce7be8d9500fbfcf27e386d620",
  "current_round": 3,
  "reps": 3,
  "model": "claude-haiku-4-5",
  "goal": {
    "target": [
      "quote_ok",
      "format_ok"
    ],
    "direction": "higher",
    "hold": [
      "correct",
      "recall",
      "specificity",
      "field_ok",
      "covered"
    ],
    "note": "retargeted 2026-10-02: test correct 0.92 at baseline, headroom < \u00b114 noise"
  },
  "approve_each_round": false,
  "stopping": {
    "max_rounds": 3,
    "plateau_rounds": 3,
    "delta": 0.1
  },
  "scope": {
    "will_change": [
