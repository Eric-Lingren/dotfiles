+norm = lambda s: re.sub(r"\s+", " ", s).strip()
+q, t = norm(sys.stdin.read()), norm(open(p, errors="replace").read())
+if q in t: print("MATCH"); sys.exit()
+words = set(re.findall(r"\w+", t))
