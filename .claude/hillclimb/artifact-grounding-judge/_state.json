  "summary": {
    "what": "Tests whether the artifact-grounding-judge agent catches made-up evidence in learning records before they are saved, without blocking real records.",
    "metrics": {
      "verdict_correct": "Did the judge give the right answer (pass or reject)? This is the main score.",
      "confidence_correct": "Did it set confidence right? A reworded quote or a missing file should lower it to candidate.",
      "write_correct": "Did it save the record when it passed, and never when it rejected?",
      "format_ok": "Did it reply with one bare JSON object, as its instructions require (no code block, no prose)?"
    },
    "kinds": {
      "exact": "Real records, unchanged. Should pass.",
      "fabricated": "One word in a quote changed. Should reject.",
      "wrong_file": "A real quote cited against the wrong file. Should reject.",
      "paraphrase": "A quote reworded, same meaning. Should pass and lower confidence.",
      "whitespace": "A multi-line quote flattened to one line. Should pass.",
      "missing_file": "A cited file does not exist. Should pass with confidence candidate.",
      "missing_plus_fab": "A missing file plus a fake quote. Should reject.",
      "absence_true": "A true 'X is not in this file' claim. Should pass.",
      "absence_false": "A false 'X is not in this file' claim. Should reject."
    },
    "groups": {
      "Pass real records": [
        "exact",
        "paraphrase",
        "whitespace",
        "missing_file",
        "absence_true"
      ],
      "Catch fakes": [
        "fabricated",
        "wrong_file",
        "missing_plus_fab",
        "absence_false"
      ]
    },
    "case_notes": "claude-code-shared/evals/artifact-grounding-judge/case_notes.jsonl"
  },
  "current_round": 3,
  "reps": 3,
  "approve_each_round": false,
  "goal": {
    "target": "verdict_correct",
    "direction": "higher",
    "focus": "fakes caught",
    "hold": [
      "real records passed",
      "confidence_correct"
    ],
    "stop_when": "fakes caught >= 0.98 AND write_correct == 1.0 AND real passed >= 0.97 (test split)",
    "max_rounds": 3,
    "budget_usd_per_round": 6.5
  },
