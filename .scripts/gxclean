#!/usr/bin/env bash
# gxclean — remove local branches and worktrees for merged work
# LOCAL ONLY — never touches remote branches or PRs
# Flags:
#   --no-full   skip worktree removal and ref pruning

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/gx-lib.sh"

gx_load_policy 2>/dev/null

BASE="${GX_BASE_BRANCH:-main}"
CURRENT=$(git rev-parse --abbrev-ref HEAD)

FULL=true
for arg in "$@"; do
  case "$arg" in
    --no-full) FULL=false ;;
  esac
done

if [[ "$CURRENT" == "$BASE" ]]; then
  echo "⚠  Currently on base branch ($BASE)"
  echo ""
fi

# ─── Pass 1: Local merged branches ──────────────────────────────

# Collect: merged into base OR tracking set + remote gone (squash merges)
MERGED_LIST=$(
  git branch --merged "origin/$BASE" 2>/dev/null \
    | grep -v "^\*" \
    | grep -v "^\s*$BASE$" \
    | sed 's/^[[:space:]+]*//' \
    | grep -v "^$"
)

ALL_LOCAL=$(
  git branch 2>/dev/null \
    | grep -v "^\*" \
    | grep -v "^\s*$BASE$" \
    | sed 's/^[[:space:]+]*//' \
    | grep -v "^$"
)

while IFS= read -r branch; do
  [[ -z "$branch" ]] && continue
  echo "$MERGED_LIST" | grep -qx "$branch" && continue
  had_tracking=$(git config --get "branch.$branch.remote" 2>/dev/null || true)
  if [[ -n "$had_tracking" ]] && ! git rev-parse --verify "origin/$branch" &>/dev/null; then
    MERGED_LIST="${MERGED_LIST:+$MERGED_LIST
}$branch"
  fi
done <<< "$ALL_LOCAL"

if [[ -z "$MERGED_LIST" ]]; then
  echo "No merged local branches."
else
  BRANCHES=()
  while IFS= read -r branch; do
    [[ -z "$branch" ]] && continue
    BRANCHES+=("$branch")
  done <<< "$MERGED_LIST"

  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  Delete ${#BRANCHES[@]} LOCAL branches (no remote changes)"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  for branch in "${BRANCHES[@]}"; do
    echo "  $branch"
  done
  echo ""
  printf "Delete all? [Y/n] "
  read -r ans
  if [[ "$ans" == "n" || "$ans" == "N" ]]; then
    echo "Skipped."
  else
    for branch in "${BRANCHES[@]}"; do
      if git branch -d "$branch" 2>&1; then
        echo "  ✓ $branch"
      else
        echo "  ✗ $branch"
      fi
    done
  fi
fi

# ─── Pass 2: Merged worktrees (--full only) ─────────────────────
if [[ "$FULL" == true ]]; then
  echo ""

  MERGED_WTS=()
  MERGED_WT_BRANCHES=()
  WORKTREE_PATH=""
  WORKTREE_BRANCH=""

  while IFS= read -r line; do
    if [[ "$line" == worktree\ * ]]; then
      WORKTREE_PATH="${line#worktree }"
      WORKTREE_BRANCH=""
    elif [[ "$line" == branch\ refs/heads/* ]]; then
      WORKTREE_BRANCH="${line#branch refs/heads/}"
    elif [[ -z "$line" && -n "$WORKTREE_PATH" && -n "$WORKTREE_BRANCH" ]]; then
      IS_MERGED=""
      wt_had_tracking=$(git config --get "branch.$WORKTREE_BRANCH.remote" 2>/dev/null || true)
      if [[ -n "$wt_had_tracking" ]] && ! git rev-parse --verify "origin/$WORKTREE_BRANCH" &>/dev/null; then
        IS_MERGED="yes"
      elif git merge-base --is-ancestor "$WORKTREE_BRANCH" "origin/$BASE" 2>/dev/null; then
        IS_MERGED="yes"
      fi
      if [[ -n "$IS_MERGED" ]]; then
        MERGED_WTS+=("$WORKTREE_PATH")
        MERGED_WT_BRANCHES+=("$WORKTREE_BRANCH")
      fi
      WORKTREE_PATH=""
      WORKTREE_BRANCH=""
    fi
  done < <(git worktree list --porcelain 2>/dev/null; echo "")

  if [[ ${#MERGED_WTS[@]} -eq 0 ]]; then
    echo "No merged worktrees."
  else
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  Remove ${#MERGED_WTS[@]} LOCAL worktrees (no remote changes)"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    for i in "${!MERGED_WTS[@]}"; do
      echo "  ${MERGED_WTS[$i]}  (${MERGED_WT_BRANCHES[$i]})"
    done
    echo ""
    printf "Remove all? [Y/n] "
    read -r ans
    if [[ "$ans" == "n" || "$ans" == "N" ]]; then
      echo "Skipped."
    else
      for wt_path in "${MERGED_WTS[@]}"; do
        if wt rm "$wt_path" 2>&1; then
          echo "  ✓ $wt_path"
        else
          echo "  ✗ $wt_path"
        fi
      done
    fi
  fi

  # Pass 3: Prune stale local tracking refs
  echo ""
  git fetch --prune origin 2>/dev/null
  echo "✓ Pruned stale local tracking refs."
fi

echo ""
echo "Done. No remote branches were modified."
