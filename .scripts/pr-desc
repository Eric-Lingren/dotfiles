#!/bin/bash
# pr-desc — AI-generated GitHub PR description from branch diff
# What: feeds branch commits and diff to Claude and returns a formatted PR body
#       with a Linear ticket link (Quaester-Web) or GitHub issue link (all others)
# When: before opening a PR; --stdout prints to terminal, default copies to clipboard

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/gx-lib.sh"
gx_load_policy 2>/dev/null

STDOUT_MODE=false
for arg in "$@"; do
  [[ "$arg" == "--stdout" ]] && STDOUT_MODE=true
done

BRANCH=$(git rev-parse --abbrev-ref HEAD)
BRANCH_SLUG=$(echo "$BRANCH" | tr '/' '-')
BASE="${GX_BASE_BRANCH:-main}"
COMMITS=$(git log "$BASE"...HEAD --oneline)
DIFF=$(git diff "$BASE"...HEAD | head -n 300)

# Build issue link based on tracker type
ISSUE_LINK=""
if [[ "${GX_ISSUE_TRACKER:-github}" == "linear" ]]; then
  TICKET=$(echo "$BRANCH" | grep -oE '[A-Za-z]+-[0-9]+' | tr '[:lower:]' '[:upper:]')
  if [[ -n "$TICKET" ]]; then
    LINEAR_URL="https://linear.app/standard-metrics/issue/$TICKET"
    ISSUE_LINK="Linear Ticket: [$TICKET]($LINEAR_URL)"
  fi
else
  ISSUE_NUM=""
  if [[ -n "${GITHUB_CLOSES:-}" ]]; then
    ISSUE_NUM="$GITHUB_CLOSES"
  elif [[ "$BRANCH_SLUG" =~ gh-([0-9]+) ]]; then
    ISSUE_NUM="${BASH_REMATCH[1]}"
  fi
  if [[ -n "$ISSUE_NUM" ]]; then
    REMOTE_URL=$(git remote get-url origin 2>/dev/null)
    REPO_PATH=$(gx_normalize_url "$REMOTE_URL")
    GITHUB_ISSUE_URL="https://github.com/$REPO_PATH/issues/$ISSUE_NUM"
    ISSUE_LINK="GitHub Issue: [#$ISSUE_NUM]($GITHUB_ISSUE_URL)"
  fi
fi

ISSUE_LINE=""
[[ -n "$ISSUE_LINK" ]] && ISSUE_LINE="
$ISSUE_LINK"

PROMPT="Branch: $BRANCH
Commits:
$COMMITS

Diff (truncated):
$DIFF

---
Write a concise GitHub PR description in this exact format:

### <short descriptive title>$ISSUE_LINE

<2-3 sentences: what was broken or missing, and what this PR does to fix it>

**Changes:**
<bullet list of key code changes, skip test files unless they're the point>

Rules:
- No Testing section
- Under 250 words
- No other sections or commentary
- No em dashes
- Separate thoughts with periods or commas only
- Concise, no run-on sentences"

CLAUDE_BIN=$(gx_claude_bin)
BODY=$(CLAUDE_CONFIG_DIR="${GX_CLAUDE_CONFIG:-$HOME/.cch}" "$CLAUDE_BIN" -p "$PROMPT")

if $STDOUT_MODE; then
  echo "$BODY"
else
  echo "$BODY" | pbcopy
  echo "SUCCESS -- PR description copied to clipboard."
fi
