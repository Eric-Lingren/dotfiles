#!/usr/bin/env bash
# worktree — smart git worktree resolver and manager
# What: resolves or creates a worktree at ~/Documents/dev/worktrees/<repo>/<branch>; also lists and removes worktrees
# When: called by the `wt` zsh function; all user-visible output goes to stderr so the zsh function can cd to stdout safely

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/gx-lib.sh"

WORKTREE_BASE="${WORKTREE_BASE:-$HOME/Documents/dev/worktrees}"

# ─── Help ──────────────────────────────────────────────────────────────────────

print_help() {
  cat >&2 <<'EOF'
wt — git worktree helper

USAGE
  wt <branch> [base]  resolve or create a worktree
  wt ls               list worktrees for the current repo
  wt ls --all         list all worktrees across all repos
  wt stop <branch>    kill processes running from a worktree
  wt rm <branch>      stop processes + remove a worktree (keeps the branch)
  wt rm <branch> --force  remove even with uncommitted or unpushed changes
  wt -h, wt --help    show this help

FLAGS
  --no-install        skip the dependency install step
  --no-links          skip the local config symlink step

WORKTREE LOCATION
  ~/Documents/dev/worktrees/<repo>/<branch>

DEPENDENCIES
  node_modules is gitignored, so a new worktree starts empty. On create, deps
  are installed for the repo root and each immediate subdir holding a
  package.json, using the package manager named by its lockfile. On attach,
  only dirs still missing node_modules are installed.

LOCAL CONFIG
  Gitignored config listed under "worktree_links" in repo-policy.json is
  symlinked from the main worktree into each new worktree. A plain branch
  checkout leaves such files untouched, so every branch reads one shared file.
  Symlinks reproduce that. Existing regular files are never overwritten.

BRANCH PREFIXES
  Recommended: feat/, fix/, spike/
  A warning is printed for branches that lack a recognised prefix.
EOF
}

# ─── Output helper ────────────────────────────────────────────────────────────

emit_path() {
  echo "$1"
}

# ─── Repo resolution helper ────────────────────────────────────────────────────

# Resolve the MAIN worktree root, never the current one.
#
# git rev-parse --show-toplevel returns whichever worktree you are standing in.
# Running wt from inside a worktree would therefore name the repo after the
# branch's leaf directory, and nest new worktrees under the wrong parent.
#
# --git-common-dir always points at the main clone's .git. It comes back
# relative (".git", "../.git") when you are already in the main worktree, and
# absolute ("/path/to/repo/.git") when you are in a linked one.
main_worktree_root() {
  local common
  common=$(git rev-parse --git-common-dir 2>/dev/null) || return 1
  [[ -n "$common" ]] || return 1

  if [[ "$common" != /* ]]; then
    # Relative form: already in the main worktree.
    git rev-parse --show-toplevel 2>/dev/null
    return
  fi

  echo "${common%/.git}"
}

resolve_repo() {
  REPO_ROOT=$(main_worktree_root) || {
    echo "ERROR: not inside a git repository" >&2
    exit 1
  }
  if [[ -z "$REPO_ROOT" ]]; then
    echo "ERROR: not inside a git repository" >&2
    exit 1
  fi
  REPO_NAME=$(basename "$REPO_ROOT")
}

# ─── ls subcommand ─────────────────────────────────────────────────────────────

cmd_ls() {
  local all=false
  [[ "${1:-}" == "--all" ]] && all=true

  if $all; then
    echo "All worktrees under $WORKTREE_BASE:" >&2
    if [[ -d "$WORKTREE_BASE" ]]; then
      local found=false
      while IFS= read -r git_file; do
        local wt_dir
        wt_dir=$(dirname "$git_file")
        local rel="${wt_dir#$WORKTREE_BASE/}"
        printf "  %s\n" "$rel" >&2
        found=true
      done < <(find "$WORKTREE_BASE" -name ".git" -not -type d 2>/dev/null | sort)
      $found || echo "  (none)" >&2
    else
      echo "  (none)" >&2
    fi
  else
    resolve_repo
    local repo_dir="$WORKTREE_BASE/$REPO_NAME"
    echo "Worktrees for $REPO_NAME:" >&2
    if [[ -d "$repo_dir" ]]; then
      local found=false
      while IFS= read -r git_file; do
        local wt_dir
        wt_dir=$(dirname "$git_file")
        local rel="${wt_dir#$repo_dir/}"
        printf "  %s\n" "$rel" >&2
        found=true
      done < <(find "$repo_dir" -name ".git" -not -type d 2>/dev/null | sort)
      $found || echo "  (none)" >&2
    else
      echo "  (none)" >&2
    fi
  fi
}

# ─── rm subcommand ─────────────────────────────────────────────────────────────

cmd_rm() {
  local branch="" force=false
  for rm_arg in "$@"; do
    case "$rm_arg" in
      --force) force=true ;;
      *) branch="$rm_arg" ;;
    esac
  done

  if [[ -z "$branch" ]]; then
    echo "ERROR: wt rm requires a branch argument" >&2
    echo "  Usage: wt rm <branch> [--force]" >&2
    exit 1
  fi

  resolve_repo
  local wt_path="$WORKTREE_BASE/$REPO_NAME/$branch"

  if [[ ! -d "$wt_path" ]]; then
    echo "ERROR: worktree not found: $wt_path" >&2
    exit 1
  fi

  # Safety: check for uncommitted changes
  local dirty
  dirty=$(git -C "$wt_path" status --porcelain 2>/dev/null)
  if [[ -n "$dirty" ]] && ! $force; then
    echo "ERROR: worktree '$branch' has uncommitted changes. Use --force to remove anyway." >&2
    exit 1
  fi

  # Safety: check for unpushed commits
  local unpushed
  unpushed=$(git -C "$wt_path" log @{u}.. --oneline 2>/dev/null)
  if [[ -n "$unpushed" ]] && ! $force; then
    echo "ERROR: worktree '$branch' has unpushed commits. Use --force to remove anyway." >&2
    exit 1
  fi

  # Kill running processes before removal
  stop_worktree_processes "$wt_path"

  # Remove and prune
  local rm_flags=()
  $force && rm_flags+=(--force)
  if ! git worktree remove "${rm_flags[@]}" "$wt_path"; then
    echo "ERROR: git worktree remove failed" >&2
    exit 1
  fi
  git worktree prune
  echo "Removed worktree for branch '$branch'" >&2
}

# ─── Process cleanup ─────────────────────────────────────────────────────────

# Kills processes whose command line contains the worktree path.
# Catches orphaned dev servers, webpack, Celery workers, etc.
#
# $1 worktree dir.
stop_worktree_processes() {
  local wt_dir="$1"
  local pids

  pids=$(pgrep -f "$wt_dir" 2>/dev/null | grep -v "^$$\$" || true)
  if [[ -z "$pids" ]]; then
    return 0
  fi

  echo "stopping processes running from $wt_dir..." >&2
  echo "$pids" | xargs kill 2>/dev/null || true
  sleep 1

  # SIGKILL stragglers
  pids=$(pgrep -f "$wt_dir" 2>/dev/null | grep -v "^$$\$" || true)
  if [[ -n "$pids" ]]; then
    echo "force-killing remaining processes..." >&2
    echo "$pids" | xargs kill -9 2>/dev/null || true
  fi
}

# ─── stop subcommand ─────────────────────────────────────────────────────────

cmd_stop() {
  local branch="${1:-}"

  if [[ -z "$branch" ]]; then
    echo "ERROR: wt stop requires a branch argument" >&2
    echo "  Usage: wt stop <branch>" >&2
    exit 1
  fi

  resolve_repo
  local wt_path="$WORKTREE_BASE/$REPO_NAME/$branch"

  if [[ ! -d "$wt_path" ]]; then
    echo "ERROR: worktree not found: $wt_path" >&2
    exit 1
  fi

  stop_worktree_processes "$wt_path"
  echo "Stopped all processes for worktree '$branch'" >&2
}

# ─── Dependency install ───────────────────────────────────────────────────────

# Installs JS deps for the repo root and each immediate subdir holding a
# package.json. node_modules is gitignored, so a fresh worktree has none, and
# the editor reports every import as unresolved until this runs.
#
# $1 worktree dir. $2 "true" to skip dirs that already have node_modules.
install_deps() {
  local wt_dir="$1"
  local only_if_missing="${2:-false}"
  local dir pm label

  [[ "$INSTALL_DEPS" == true ]] || return 0

  for dir in "$wt_dir" "$wt_dir"/*/; do
    dir="${dir%/}"
    [[ -d "$dir" ]] || continue
    [[ -f "$dir/package.json" ]] || continue
    [[ "$only_if_missing" == true && -d "$dir/node_modules" ]] && continue

    if [[ -f "$dir/pnpm-lock.yaml" ]]; then
      pm="pnpm"
    elif [[ -f "$dir/yarn.lock" ]]; then
      pm="yarn"
    elif [[ -f "$dir/bun.lockb" || -f "$dir/bun.lock" ]]; then
      pm="bun"
    elif [[ -f "$dir/package-lock.json" ]]; then
      pm="npm"
    else
      continue
    fi

    label="${dir#$wt_dir}"
    label="${label#/}"
    [[ -n "$label" ]] || label="."

    if [[ -z "$(command -v "$pm")" ]]; then
      echo "WARN: $pm not on PATH; skipping install in $label" >&2
      continue
    fi

    echo "installing deps: $pm install in $label" >&2
    ( cd "$dir" && "$pm" install >&2 ) || \
      echo "WARN: $pm install failed in $label; worktree usable but deps incomplete" >&2
  done
}

# ─── Local config links ───────────────────────────────────────────────────────

# Symlinks gitignored local config from the main worktree into a new worktree.
# git leaves ignored files alone on checkout, so one directory switching
# branches sees a single shared .env. A symlink gives a worktree the same
# behaviour. A copy would not: it drifts the moment a credential is rotated.
#
# $1 worktree dir.
link_local_config() {
  local wt_dir="$1"
  local main_root rel src dest dest_parent

  [[ "$LINK_CONFIG" == true ]] || return 0

  main_root=$(main_worktree_root) || return 0
  [[ -n "$main_root" ]] || return 0

  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    src="$main_root/$rel"
    dest="$wt_dir/$rel"

    if [[ ! -e "$src" ]]; then
      echo "WARN: local config '$rel' not found in $main_root; skipping" >&2
      continue
    fi

    if [[ -L "$dest" ]]; then
      continue
    fi

    if [[ -e "$dest" ]]; then
      echo "WARN: '$rel' already exists in worktree as a real file; leaving it alone" >&2
      continue
    fi

    dest_parent=$(dirname "$dest")
    [[ -d "$dest_parent" ]] || mkdir -p "$dest_parent"

    if ln -s "$src" "$dest" 2>/dev/null; then
      echo "linked local config: $rel -> $src" >&2
    else
      echo "WARN: could not link '$rel' into worktree" >&2
    fi
  done < <(gx_worktree_links)
}

# ─── Flag extraction ──────────────────────────────────────────────────────────

INSTALL_DEPS=true
LINK_CONFIG=true
WT_ARGS=()
for wt_arg in "$@"; do
  case "$wt_arg" in
    --no-install) INSTALL_DEPS=false ;;
    --no-links) LINK_CONFIG=false ;;
    *) WT_ARGS+=("$wt_arg") ;;
  esac
done
set -- "${WT_ARGS[@]}"

# ─── Dispatch ─────────────────────────────────────────────────────────────────

CMD="${1:-}"

case "$CMD" in
  ls)
    shift
    cmd_ls "$@"
    exit 0
    ;;
  stop)
    shift
    cmd_stop "$@"
    exit 0
    ;;
  rm)
    shift
    cmd_rm "$@"
    exit 0
    ;;
  -h|--help)
    print_help
    exit 0
    ;;
  "")
    print_help
    echo "" >&2
    cmd_ls
    exit 0
    ;;
esac

# ─── Branch resolution (original behaviour) ───────────────────────────────────

BRANCH="$CMD"
BASE_OVERRIDE="${2:-}"

# If the argument is a Linear URL, extract the ticket slug as the branch name
if [[ "$BRANCH" == https://linear.app/* ]]; then
  # URL shape: https://linear.app/<org>/issue/<KEY-NNNN>/<description>
  local_slug="${BRANCH#*\/issue\/}"       # KEY-NNNN/description
  local_key="${local_slug%%/*}"            # KEY-NNNN
  local_desc="${local_slug#*/}"            # description
  local_desc="${local_desc%%\?*}"          # strip query params
  local_desc="${local_desc%%#*}"           # strip fragment
  if [[ -n "$local_key" && -n "$local_desc" && "$local_desc" != "$local_key" ]]; then
    BRANCH="${local_key}-${local_desc}"
  elif [[ -n "$local_key" ]]; then
    BRANCH="$local_key"
  fi
  unset local_slug local_key local_desc
fi

# Resolve repo root and name (always the MAIN worktree, see main_worktree_root)
resolve_repo

# Worktree path formula (WORKTREE_BASE is overridable for tests)
WORKTREE_DIR="$WORKTREE_BASE/$REPO_NAME/$BRANCH"

# Load policy silently; fall back to defaults on any error
gx_load_policy 2>/dev/null || true

# Resolve base branch (explicit arg wins over policy, policy wins over default)
if [[ -n "$BASE_OVERRIDE" ]]; then
  BASE="$BASE_OVERRIDE"
else
  BASE="${GX_BASE_BRANCH:-main}"
fi

# Warn when branch name lacks a recognised prefix
if [[ "$BRANCH" != feat/* && "$BRANCH" != fix/* && "$BRANCH" != spike/* ]]; then
  echo "WARN: branch '$BRANCH' is missing a feat/, fix/, or spike/ prefix" >&2
fi

# ─── Resolution ───────────────────────────────────────────────────────────────

# Case 1: worktree folder already exists — attach to it
if [[ -d "$WORKTREE_DIR" ]]; then
  echo "attaching to existing branch $BRANCH" >&2
  link_local_config "$WORKTREE_DIR"
  install_deps "$WORKTREE_DIR" true
  emit_path "$WORKTREE_DIR"
  exit 0
fi

# Case 2: branch exists locally but no worktree folder
if git show-ref --verify --quiet "refs/heads/$BRANCH" 2>/dev/null; then
  mkdir -p "$(dirname "$WORKTREE_DIR")"
  git worktree add "$WORKTREE_DIR" "$BRANCH" >&2
  link_local_config "$WORKTREE_DIR"
  install_deps "$WORKTREE_DIR"
  emit_path "$WORKTREE_DIR"
  exit 0
fi

# Case 3: branch exists on remote only — fetch then create
if git ls-remote --heads origin "$BRANCH" 2>/dev/null | grep -q "refs/heads/$BRANCH"; then
  git fetch origin "$BRANCH:$BRANCH" >&2
  mkdir -p "$(dirname "$WORKTREE_DIR")"
  git worktree add "$WORKTREE_DIR" "$BRANCH" >&2
  link_local_config "$WORKTREE_DIR"
  install_deps "$WORKTREE_DIR"
  emit_path "$WORKTREE_DIR"
  exit 0
fi

# Case 4: branch exists nowhere — prompt before creating
printf "Branch '%s' does not exist. Create from '%s'? [Y/n] " "$BRANCH" "$BASE" >&2
read -r CONFIRM
if [[ "$CONFIRM" == "n" || "$CONFIRM" == "N" ]]; then
  echo "Aborted." >&2
  exit 2
fi

mkdir -p "$(dirname "$WORKTREE_DIR")"
git worktree add -b "$BRANCH" "$WORKTREE_DIR" "$BASE" >&2
link_local_config "$WORKTREE_DIR"
install_deps "$WORKTREE_DIR"
emit_path "$WORKTREE_DIR"
exit 0
