#!/usr/bin/env bash
# gxsync — sync feature branch with base via merge
# What: fetches origin and merges origin/<base> into the current feature branch, showing ahead/behind counts first
# When: feature branch is behind main; prompts before merging; auto-resolves lockfile conflicts, exits 1 only on source conflicts

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/gx-lib.sh"

gx_load_policy 2>/dev/null

BASE=$("$SCRIPT_DIR/gxbase")
CURRENT=$(git rev-parse --abbrev-ref HEAD)

if [[ "$CURRENT" == "$BASE" ]]; then
  echo "Already on base branch ($BASE). Nothing to sync."
  exit 0
fi

# Fetch latest from origin
echo "Fetching from origin..."
git fetch origin

AHEAD=$(git rev-list --count "origin/$BASE..HEAD" 2>/dev/null || echo "?")
BEHIND=$(git rev-list --count "HEAD..origin/$BASE" 2>/dev/null || echo "?")

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  gxsync — merge preview"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "Will merge origin/$BASE into $CURRENT"
echo "  $AHEAD commit(s) ahead of origin/$BASE"
echo "  $BEHIND commit(s) behind origin/$BASE"
echo ""

if [[ "$BEHIND" == "0" || "$BEHIND" == "?" && "$AHEAD" != "?" ]]; then
  echo "Branch is already up to date with origin/$BASE."
  [[ "$BEHIND" == "0" ]] && exit 0
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
printf "Proceed? [Y/n] "
read -r CONFIRM
if [[ "$CONFIRM" == "n" || "$CONFIRM" == "N" ]]; then
  echo "Aborted."
  exit 0
fi

echo ""
git merge "origin/$BASE"
MERGE_EXIT=$?

if [[ $MERGE_EXIT -ne 0 ]]; then
  echo ""
  echo "Merge conflict detected. Attempting auto-resolution..."
  echo ""

  AUTO_RESOLVED=()
  UNRESOLVED=()

  while IFS= read -r f; do
    case "$f" in
      package-lock.json|yarn.lock|pnpm-lock.json|Gemfile.lock|Pipfile.lock|\
      poetry.lock|composer.lock|Cargo.lock|go.sum|*.lock)
        git checkout --theirs -- "$f" 2>/dev/null && git add "$f"
        AUTO_RESOLVED+=("$f")
        ;;
      *)
        UNRESOLVED+=("$f")
        ;;
    esac
  done < <(git diff --name-only --diff-filter=U)

  if [[ ${#AUTO_RESOLVED[@]} -gt 0 ]]; then
    echo "Auto-resolved (accepted theirs):"
    for f in "${AUTO_RESOLVED[@]}"; do
      echo "  $f"
    done
    echo ""
  fi

  if [[ ${#UNRESOLVED[@]} -gt 0 ]]; then
    echo "Unresolved source conflicts:"
    for f in "${UNRESOLVED[@]}"; do
      echo "  $f"
    done
    echo ""

    CLAUDE_BIN=$(gx_claude_bin)
    FILE_LIST=$(printf '%s\n' "${UNRESOLVED[@]}")

    echo "Spawning Claude agent to resolve conflicts..."
    echo ""
    "$CLAUDE_BIN" --print \
      -p "You are resolving merge conflicts in a git repository. The following files have merge conflict markers (<<<<<<< ======= >>>>>>>):

$FILE_LIST

For each file:
1. Read the file
2. Understand both sides of each conflict
3. Produce the correct merged result that preserves intent from both sides
4. Write the resolved file (no conflict markers remaining)
5. Run: git add <file>

Do not delete functionality from either side unless it is truly redundant. Prefer combining both changes when possible. If one side clearly supersedes the other, pick that side." 2>&1

    # Check if conflicts remain
    STILL_CONFLICTED=$(git diff --name-only --diff-filter=U 2>/dev/null)
    if [[ -n "$STILL_CONFLICTED" ]]; then
      echo ""
      echo "Agent could not resolve all conflicts. Remaining:"
      echo "$STILL_CONFLICTED" | while IFS= read -r f; do
        echo "  $f"
      done
      echo ""
      echo "Resolve manually, then run: git merge --continue"
      exit 1
    fi
  fi

  # All conflicts auto-resolved. Complete merge.
  GIT_EDITOR=true git merge --continue
  echo "All conflicts auto-resolved. Merge complete."
fi

echo ""
echo "Sync complete. $CURRENT is now up to date with origin/$BASE."
