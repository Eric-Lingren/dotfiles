#!/usr/bin/env bash
# gxlist — worktree inventory dashboard
# What: scans worktree directories, reads .worktree-meta.json, auto-detects building state
# When: reviewing active worktrees by status (READY / BUILDING / PICKED)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/gx-lib.sh"

# Allow tests to override the worktree root
WORKTREE_BASE="${WORKTREE_BASE:-$HOME/Documents/dev/worktrees}"
SHOW_ALL=false
FILTER_TICKET=""

# ─── Argument parsing ─────────────────────────────────────────────────────────

while [[ $# -gt 0 ]]; do
  case "$1" in
    --all) SHOW_ALL=true ;;
    -*)
      echo "Usage: gxlist [--all] [<linear-url-or-ticket-id>]" >&2
      exit 1
      ;;
    *)
      if [[ "$1" == https://* ]]; then
        FILTER_TICKET=$(printf '%s' "$1" | grep -oE '[A-Z][A-Z0-9]+-[0-9]+' | tail -1)
        if [[ -z "$FILTER_TICKET" ]]; then
          echo "ERROR: could not extract ticket ID from URL '$1'" >&2
          exit 1
        fi
      else
        FILTER_TICKET="$1"
      fi
      SHOW_ALL=true
      ;;
  esac
  shift
done

# ─── Current repo detection ───────────────────────────────────────────────────

# Returns the basename of the current git repo's top-level dir.
# Tests can override via GXLIST_CURRENT_REPO env var.
gxlist_current_repo() {
  if [[ -n "${GXLIST_CURRENT_REPO:-}" ]]; then
    echo "$GXLIST_CURRENT_REPO"
    return
  fi
  local toplevel
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [[ -z "$toplevel" ]]; then
    echo ""
    return
  fi
  basename "$toplevel"
}

# ─── Building detection ───────────────────────────────────────────────────────

# Returns 0 (true) if the worktree has local commits ahead of origin/<base_branch>.
# The `git` command can be overridden in tests by defining a `git` bash function
# before sourcing or calling this function.
gxlist_is_building() {
  local worktree_path="$1"
  local base_branch="$2"

  local count
  count=$(git -C "$worktree_path" log "origin/${base_branch}..HEAD" --oneline 2>/dev/null | wc -l | tr -d ' ')
  [[ "$count" -gt 0 ]]
}

# ─── OSC 8 hyperlink ──────────────────────────────────────────────────────────

# Emit an OSC 8 terminal hyperlink. Modern terminals (iTerm2, Kitty, etc.)
# render it as a clickable link; others fall back to displaying plain text.
gxlist_hyperlink() {
  local url="$1"
  local text="$2"
  printf '\033]8;;%s\033\\%s\033]8;;\033\\' "$url" "$text"
}

# ─── Scan one repo directory ──────────────────────────────────────────────────

# Scans subdirectories of repo_dir, reads .worktree-meta.json from each,
# auto-detects building status, and emits tab-separated records:
#   <status>\t<ticket_title>\t<branch_name>\t<linear_url>
scan_repo_dir() {
  local repo_dir="$1"
  local base_branch="${GX_BASE_BRANCH:-main}"

  if [[ ! -d "$repo_dir" ]]; then
    return
  fi

  local meta_file subdir
  while IFS= read -r -d '' meta_file; do
    subdir=$(dirname "$meta_file")

    # Parse and validate the meta file
    local parsed
    if ! parsed=$(python3 - "$meta_file" <<'PYEOF' 2>/dev/null
import json, sys
path = sys.argv[1]
try:
    with open(path) as f:
        d = json.load(f)
    for k in ('linear_ticket_id', 'linear_url', 'ticket_title', 'branch_name', 'status'):
        if k not in d:
            raise KeyError(f"missing key: {k}")
    print(d['ticket_title'])
    print(d['branch_name'])
    print(d['linear_url'])
    print(d['status'])
except (json.JSONDecodeError, KeyError, OSError) as e:
    print(str(e), file=sys.stderr)
    sys.exit(1)
PYEOF
); then
      echo "WARNING: malformed .worktree-meta.json in $subdir" >&2
      continue
    fi

    local ticket_title branch_name linear_url status
    ticket_title=$(printf '%s\n' "$parsed" | sed -n '1p')
    branch_name=$(printf '%s\n' "$parsed" | sed -n '2p')
    linear_url=$(printf '%s\n' "$parsed" | sed -n '3p')
    status=$(printf '%s\n' "$parsed" | sed -n '4p')

    # Auto-detect merged branches → mark shipped (hidden from dashboard)
    # Branch had tracking configured (was pushed) but remote ref is now gone
    # → GitHub deleted it after merge (works for squash merges too)
    local had_tracking
    had_tracking=$(git config --get "branch.${branch_name}.remote" 2>/dev/null || true)
    if [[ -n "$had_tracking" ]] && ! git rev-parse --verify "origin/${branch_name}" &>/dev/null; then
      status="shipped"
    # Auto-upgrade 'picked' to 'building' when local commits exist.
    # Never downgrade an explicit 'ready' status — user set that intentionally.
    elif [[ "$status" != "ready" && "$status" != "in-review" ]] && gxlist_is_building "$subdir" "$base_branch"; then
      status="building"
    fi

    printf '%s\t%s\t%s\t%s\n' "$status" "$ticket_title" "$branch_name" "$linear_url"
  done < <(find "$repo_dir" -maxdepth 3 -name ".worktree-meta.json" -print0 2>/dev/null)
}

# ─── Main ─────────────────────────────────────────────────────────────────────

# When GXLIST_SOURCED=true, only define functions and return (for test sourcing).
[[ "${GXLIST_SOURCED:-false}" == "true" ]] && return 0

# Load policy for GX_BASE_BRANCH; tolerate failures (e.g. outside a git repo).
GX_BASE_BRANCH="${GX_BASE_BRANCH:-main}"
gx_load_policy 2>/dev/null || true

# Determine which directories to scan
scan_dirs=()
if [[ "$SHOW_ALL" == "true" ]]; then
  if [[ -d "$WORKTREE_BASE" ]]; then
    while IFS= read -r -d '' d; do
      scan_dirs+=("$d")
    done < <(find "$WORKTREE_BASE" -maxdepth 1 -mindepth 1 -type d -print0 2>/dev/null)
  fi
else
  local_repo=$(gxlist_current_repo)
  if [[ -z "$local_repo" ]]; then
    echo "ERROR: not inside a git repository; use --all to scan all repos" >&2
    exit 1
  fi
  scan_dirs=("$WORKTREE_BASE/$local_repo")
fi

# Collect entries by status bucket
ready=()
building=()
in_review=()
picked=()

for dir in "${scan_dirs[@]+"${scan_dirs[@]}"}"; do
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local_status=$(printf '%s' "$line" | cut -f1)
    case "$local_status" in
      ready)     ready+=("$line") ;;
      building)  building+=("$line") ;;
      in-review) in_review+=("$line") ;;
      shipped)   ;;  # shipped worktrees are excluded from the dashboard
      *)         picked+=("$line") ;;  # 'picked' and any unknown status
    esac
  done < <(scan_repo_dir "$dir")
done

# Filter mode: find matching worktree and prompt to resume
if [[ -n "$FILTER_TICKET" ]]; then
  matched=()
  for _fe in "${ready[@]+"${ready[@]}"}" "${building[@]+"${building[@]}"}" "${in_review[@]+"${in_review[@]}"}" "${picked[@]+"${picked[@]}"}"; do
    _bn=$(printf '%s' "$_fe" | cut -f3)
    if printf '%s' "$_bn" | grep -qi "$FILTER_TICKET"; then
      matched+=("$_fe")
    fi
  done

  if [[ ${#matched[@]} -eq 0 ]]; then
    echo "No worktree found for '$FILTER_TICKET'." >&2
    exit 1
  fi

  _entry="${matched[0]}"
  _status=$(printf '%s' "$_entry" | cut -f1 | tr '[:lower:]' '[:upper:]')
  _title=$(printf '%s' "$_entry" | cut -f2)
  _branch=$(printf '%s' "$_entry" | cut -f3)

  printf '%s  %s\n' "$_status" "$_title" >&2
  printf 'Branch: %s\n' "$_branch" >&2
  printf 'Do you want to start this worktree? [Y/n] ' >&2
  read -r _confirm
  if [[ -z "$_confirm" || "$_confirm" =~ ^[Yy] ]]; then
    printf '%s\n' "$_branch"
  fi
  exit 0
fi

# Empty inventory
total=$(( ${#ready[@]} + ${#building[@]} + ${#in_review[@]} + ${#picked[@]} ))
if [[ "$total" -eq 0 ]]; then
  echo "No active worktrees."
  exit 0
fi

# Format and print one entry (2 lines: title row, branch row)
print_entry() {
  local line="$1"
  local ticket_title branch_name linear_url ticket_id
  ticket_title=$(printf '%s' "$line" | cut -f2)
  branch_name=$(printf '%s' "$line" | cut -f3)
  linear_url=$(printf '%s' "$line" | cut -f4)
  ticket_id=$(printf '%s' "$branch_name" | grep -oE '[A-Z][A-Z0-9]+-[0-9]+' | head -1)
  [[ -z "$ticket_id" ]] && ticket_id="?"

  local link
  link=$(gxlist_hyperlink "$linear_url" "↗")

  # Line 1: ticket ID + title
  printf '  \033[1m%-10s\033[0m  %s\n' "$ticket_id" "$ticket_title"
  # Line 2: branch + link, indented to align under title
  printf '  %-10s  %s  %s\n' "" "$branch_name" "$link"
}

# Print a section with a bold header and blank lines between entries
print_section() {
  local header="$1"; shift
  printf '\033[1m%s\033[0m\n' "$header"
  local first=true
  for entry in "$@"; do
    $first || echo ""
    first=false
    print_entry "$entry"
  done
}

# Print grouped sections
[[ ${#ready[@]} -gt 0 ]]     && print_section "READY"     "${ready[@]}"
[[ ${#building[@]} -gt 0 ]]  && { [[ ${#ready[@]} -gt 0 ]] && echo ""; print_section "BUILDING"  "${building[@]}"; }
[[ ${#in_review[@]} -gt 0 ]] && { [[ $(( ${#ready[@]} + ${#building[@]} )) -gt 0 ]] && echo ""; print_section "IN REVIEW" "${in_review[@]}"; }
[[ ${#picked[@]} -gt 0 ]]    && { [[ $(( ${#ready[@]} + ${#building[@]} + ${#in_review[@]} )) -gt 0 ]] && echo ""; print_section "PICKED"    "${picked[@]}"; }
